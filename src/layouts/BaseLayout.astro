---
import '../styles/global.css';
import CyberCanvas from '../components/CyberCanvas.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="canonical" href="https://0xsac.com" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <CyberCanvas />

    <div class="relative z-10 min-h-screen flex flex-col overflow-x-hidden">
      <div class="max-w-4xl mx-auto w-full px-6 py-10 flex-grow flex flex-col justify-between">
      <header class="flex justify-between items-center pb-6 border-b border-slate-800">
        <a href="/" class="text-xl font-mono font-bold text-sky-400">0xSac</a>
        <nav class="space-x-6 text-sm font-mono text-slate-400">
          <a href="/" class="hover:text-white">Home</a>
          <a href="/about" class="hover:text-white">About</a>
          <a href="/resources" class="hover:text-white">Resources</a>
        </nav>
      </header>

        <main class="relative z-10 py-10 flex-grow">
          <slot />
        </main>

        <footer class="pt-8 border-t border-slate-800 text-xs font-mono text-slate-500 flex justify-between">
          <span>&copy; 2026 0xSac &bull; Sacramento, CA</span>
          <span class="text-slate-600">Annual Cyber Exercise &amp; Range Platform</span>
        </footer>
      </div>
    </div>
  </body>
</html>