---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const briefings = await getCollection('briefings');

  return briefings.map((briefing) => ({
    params: { slug: briefing.id },
    props: { briefing },
  }));
}

const { briefing } = Astro.props;
const { Content } = await render(briefing);
const canonical = `/briefings/${briefing.id}/`;
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: briefing.data.title,
  description: briefing.data.description,
  url: `https://0xsac.github.io${canonical}`,
  author: {
    '@type': 'Organization',
    name: '0xSac Community Working Group',
  },
  keywords: briefing.data.focus.join(', '),
  datePublished: briefing.data.published.toISOString(),
};
---

<BaseLayout
  title={`${briefing.data.title} | 0xSac`}
  description={briefing.data.description}
  canonical={canonical}
  ldJson={ldJson}
>
  <article class="mx-auto max-w-3xl rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-emerald-300">Briefing</p>
    <h1 class="mt-3 text-4xl font-semibold text-white">{briefing.data.title}</h1>
    <p class="mt-4 text-lg text-slate-300">{briefing.data.description}</p>
    <p class="mt-6 text-sm text-slate-500">Published {briefing.data.published.toISOString().slice(0, 10)}</p>
    <section class="prose prose-invert mt-8 max-w-none prose-headings:text-white prose-strong:text-slate-100 prose-a:text-emerald-300">
      <Content />
    </section>
  </article>
</BaseLayout>
