---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resources | 0xSac">
  <div class="max-w-4xl mx-auto px-6 py-16 space-y-12">
    
    <header class="flex justify-between items-center pb-6 border-b border-slate-800">
      <div class="text-xl font-mono font-bold text-sky-400">0xSac</div>
      <nav class="space-x-6 text-sm font-mono text-slate-400">
        <a href="/" class="hover:text-white">Home</a>
        <a href="/about" class="hover:text-white">About</a>
        <a href="/resources" class="text-white">Resources</a>
      </nav>
    </header>

    <div class="space-y-2">
      <h1 class="text-3xl font-bold text-white tracking-tight font-mono">Resources & Notes</h1>
      <p class="text-slate-400 text-sm">
        Technical notes, detection artifacts, and architecture patterns.
      </p>
    </div>

    <!-- Content Items -->
    <div class="space-y-6 border-t border-slate-800 pt-6">
      <article class="p-5 bg-slate-900/40 border border-slate-800 rounded space-y-2">
        <div class="text-xs font-mono text-sky-400">Guide</div>
        <h2 class="text-base font-bold text-white">Validating Detection Rules with Sigma</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          A framework for writing and testing Sigma rules against captured event logs to verify that SIEM pipelines trigger accurately.
        </p>
        <span class="text-xs font-mono text-slate-500 block pt-2">Coming Soon</span>
      </article>

      <article class="p-5 bg-slate-900/40 border border-slate-800 rounded space-y-2">
        <div class="text-xs font-mono text-sky-400">Blueprint</div>
        <h2 class="text-base font-bold text-white">Isolated Multi-Enclave Range Setup</h2>
        <p class="text-xs text-slate-400 leading-relaxed">
          Architecture patterns for deploying reproducible lab networks in AWS or Azure with centralized log forwarding.
        </p>
        <span class="text-xs font-mono text-slate-500 block pt-2">Coming Soon</span>
      </article>
    </div>

    <footer class="pt-8 border-t border-slate-800 text-xs font-mono text-slate-600">
      0xSac &bull; Sacramento, CA
    </footer>
  </div>
</BaseLayout>
