---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const exercises = (await getCollection('exercises')).slice(0, 3);
const briefings = (await getCollection('briefings')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
).slice(0, 3);

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '0xSac',
  url: 'https://0xsac.github.io/',
  description: 'Practitioner-led cyber exercises, detection engineering briefings, and threat-informed blueprints for Sacramento defenders.',
};
---

<BaseLayout
  title="0xSac | Sacramento Cyber Exercises"
  description="Scenario-driven cyber exercises, detection engineering briefings, and threat-informed blueprints for the Sacramento security community."
  canonical="/"
  ldJson={ldJson}
>
  <section class="grid gap-10 lg:grid-cols-[1.4fr_0.9fr] lg:items-start">
    <div class="space-y-6">
      <p class="text-sm font-medium uppercase tracking-[0.35em] text-emerald-300">Practitioner-led tradecraft</p>
      <h1 class="max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        Scenario-driven cyber exercises, threat-informed blueprints, and hands-on defensive repetitions.
      </h1>
      <p class="max-w-3xl text-lg text-slate-300">
        0xSac is a community-built Sacramento cyber exercise ecosystem focused on telemetry validation,
        detection engineering, and portable lab design. Practical keyboard reps beat check-the-box compliance reviews every time.
      </p>
      <div class="grid gap-4 sm:grid-cols-3">
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-300">Scenario injects</h2>
          <p class="mt-3 text-sm text-slate-400">Reproducible adversary chains mapped directly to MITRE ATT&CK objectives.</p>
        </article>
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-300">Detection engineering</h2>
          <p class="mt-3 text-sm text-slate-400">Sigma and YARA validation logic paired with the telemetry defenders need to trust.</p>
        </article>
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-300">Blueprints</h2>
          <p class="mt-3 text-sm text-slate-400">Vendor-neutral architecture guidance for AWS, Azure, GCP, Proxmox, and Terraform labs.</p>
        </article>
      </div>
    </div>
    <aside class="rounded-3xl border border-emerald-500/30 bg-emerald-500/10 p-6 shadow-lg shadow-emerald-950/40">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-emerald-300">Launch status</p>
      <h2 class="mt-4 text-3xl font-semibold text-white">Date TBD — More Coming Soon</h2>
      <p class="mt-4 text-sm leading-7 text-slate-200">
        Initial exercises, catalog previews, and contribution workflows are being finalized. Community proposals are accepted through GitHub Issues and Pull Requests.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://github.com/0xSac/0xsac.github.io/issues/new/choose" class="rounded-full border border-emerald-300 px-4 py-2 text-sm font-medium text-emerald-200 hover:bg-emerald-300 hover:text-slate-950">Open an issue</a>
        <a href="/exercises/" class="rounded-full border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 hover:border-slate-500">Preview scenarios</a>
      </div>
    </aside>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-emerald-300">Scenario catalog preview</p>
        <h2 class="mt-2 text-2xl font-semibold text-white">Exercise pipeline</h2>
      </div>
      <a href="/exercises/" class="text-sm text-slate-300 hover:text-emerald-300">View all exercises</a>
    </div>
    <div class="mt-6 grid gap-4 lg:grid-cols-3">
      {exercises.map((exercise) => (
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
          <p class="text-xs uppercase tracking-[0.3em] text-emerald-300">{exercise.data.difficulty}</p>
          <h3 class="mt-3 text-xl font-semibold text-white">
            <a href={`/exercises/${exercise.id}/`} class="hover:text-emerald-300">{exercise.data.title}</a>
          </h3>
          <p class="mt-3 text-sm text-slate-400">{exercise.data.description}</p>
          <p class="mt-4 text-xs text-slate-500">{exercise.data.attackIds.join(' · ')}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-emerald-300">Technical briefings</p>
        <h2 class="mt-2 text-2xl font-semibold text-white">Detection and telemetry analysis</h2>
      </div>
      <a href="/briefings/" class="text-sm text-slate-300 hover:text-emerald-300">View all briefings</a>
    </div>
    <div class="mt-6 grid gap-4 lg:grid-cols-3">
      {briefings.map((briefing) => (
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
          <p class="text-xs uppercase tracking-[0.3em] text-emerald-300">{briefing.data.focus.join(' · ')}</p>
          <h3 class="mt-3 text-xl font-semibold text-white">
            <a href={`/briefings/${briefing.id}/`} class="hover:text-emerald-300">{briefing.data.title}</a>
          </h3>
          <p class="mt-3 text-sm text-slate-400">{briefing.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
