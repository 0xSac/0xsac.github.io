---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="0xSac | Cyber Exercises & Technical Blueprints">
  <div class="space-y-16">
    
    <!-- Hero Section -->
    <section class="space-y-6 pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 backdrop-blur-sm shadow-[0_0_15px_rgba(16,185,129,0.15)]">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
        <span>Status: Staging — Date TBD</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
        Cyber exercise blueprints and hands-on scenarios.
      </h1>
      
      <p class="text-slate-400 text-lg leading-relaxed max-w-2xl">
        0xSac develops realistic threat scenarios, detection validation guides, and range blueprints for the annual Northern California cyber exercise and technical training pipeline.
      </p>
    </section>

    <!-- 3 Core Focus Pillars (Glassmorphism Cards) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="p-6 bg-slate-900/40 backdrop-blur-md border border-slate-800/80 hover:border-sky-500/40 rounded-xl transition-all duration-300 group">
        <h2 class="text-xs font-bold text-sky-400 font-mono uppercase tracking-widest group-hover:text-sky-300">
          Exercise Runbooks
        </h2>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          Step-by-step emulation paths mapped to real adversary tradecraft.
        </p>
      </div>

      <div class="p-6 bg-slate-900/40 backdrop-blur-md border border-slate-800/80 hover:border-sky-500/40 rounded-xl transition-all duration-300 group">
        <h2 class="text-xs font-bold text-sky-400 font-mono uppercase tracking-widest group-hover:text-sky-300">
          Detection Logic
        </h2>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          Production-ready Sigma rules and telemetry queries to test logging pipelines.
        </p>
      </div>

      <div class="p-6 bg-slate-900/40 backdrop-blur-md border border-slate-800/80 hover:border-sky-500/40 rounded-xl transition-all duration-300 group">
        <h2 class="text-xs font-bold text-sky-400 font-mono uppercase tracking-widest group-hover:text-sky-300">
          Range Blueprints
        </h2>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          Vendor-neutral architectures for testing in private cloud environments.
        </p>
      </div>
    </section>

    <!-- Scenarios in Development -->
    <section class="space-y-6 pt-4 border-t border-slate-800/60">
      <div class="flex justify-between items-baseline">
        <h2 class="text-sm font-mono uppercase tracking-wider text-slate-300">Current Scenarios in Development</h2>
        <span class="text-xs font-mono text-slate-500">In Design</span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 bg-slate-900/30 backdrop-blur-sm border border-slate-800/80 hover:border-slate-700 rounded-lg transition-colors">
          <div class="text-xs font-mono text-sky-400 uppercase tracking-wide">Identity</div>
          <div class="mt-2">
            <span class="inline-flex items-center rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-amber-400">Intermediate</span>
          </div>
          <h3 class="text-base font-semibold text-white mt-1">Cloud Token Replay & IAM Escalation</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Validation workflow focused on token theft, federated identity trust abuse, and telemetry alerting.
          </p>
        </div>

        <div class="p-5 bg-slate-900/30 backdrop-blur-sm border border-slate-800/80 hover:border-slate-700 rounded-lg transition-colors">
          <div class="text-xs font-mono text-sky-400 uppercase tracking-wide">Internal Network</div>
          <div class="mt-2">
            <span class="inline-flex items-center rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-amber-400">Advanced</span>
          </div>
          <h3 class="text-base font-semibold text-white mt-1">RPC & Lateral Movement Validation</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Telemetry collection and detection verification for host-to-host movement within segmented enclaves.
          </p>
        </div>
      </div>
    </section>

    <!-- Simple Sponsorship & Contact Placeholder -->
    <section class="p-6 bg-slate-900/20 backdrop-blur-sm border border-slate-800/80 rounded-xl space-y-3">
      <h2 class="text-xs font-bold text-slate-300 font-mono uppercase tracking-widest">Partnerships & Support</h2>
      <p class="text-xs text-slate-400 leading-relaxed">
        We partner with cloud providers, tool vendors, and regional organizations to sponsor compute and range infrastructure.
      </p>
      <div class="text-xs font-mono text-sky-400 pt-1">
        Contact: <a href="mailto:partner@0xsac.com" class="hover:text-sky-300 underline underline-offset-4">partner@0xsac.com</a>
      </div>
    </section>

  </div>
</BaseLayout>
