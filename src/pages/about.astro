---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | 0xSac">
  <div class="max-w-3xl mx-auto px-6 py-16 space-y-12">
    
    <header class="flex justify-between items-center pb-6 border-b border-slate-800">
      <div class="text-xl font-mono font-bold text-sky-400">0xSac</div>
      <nav class="space-x-6 text-sm font-mono text-slate-400">
        <a href="/" class="hover:text-white">Home</a>
        <a href="/about" class="text-white">About</a>
        <a href="/resources" class="hover:text-white">Resources</a>
      </nav>
    </header>

    <div class="space-y-4">
      <h1 class="text-3xl font-bold text-white tracking-tight font-mono">About 0xSac</h1>
      <p class="text-slate-400 text-base leading-relaxed">
        0xSac is an initiative focused on building practical, scenario-based cyber exercises and blueprints in Northern California.
      </p>
    </div>

    <!-- Mission & Vision -->
    <div class="space-y-8 border-t border-slate-800 pt-8">
      <div class="space-y-2">
        <h2 class="text-sm font-mono uppercase tracking-wider text-sky-400 font-semibold">Vision</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Provide realistic, accessible technical training environments where security teams can test controls and observe attacker paths firsthand.
        </p>
      </div>

      <div class="space-y-2">
        <h2 class="text-sm font-mono uppercase tracking-wider text-sky-400 font-semibold">Mission</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Design repeatable, threat-informed exercise runbooks and range architectures that help teams validate detections and evaluate their real-world readiness.
        </p>
      </div>

      <div class="space-y-2">
        <h2 class="text-sm font-mono uppercase tracking-wider text-sky-400 font-semibold">Operational Boundaries</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          All scenarios, topologies, and blueprints are developed independently using vendor-neutral cloud platforms and open-source tooling. We do not use proprietary agency networks or live operational systems.
        </p>
      </div>
    </div>

    <footer class="pt-8 border-t border-slate-800 text-xs font-mono text-slate-600">
      0xSac &bull; Sacramento, CA
    </footer>
  </div>
</BaseLayout>
