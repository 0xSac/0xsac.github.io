---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const exercises = await getCollection('exercises');
---

<BaseLayout
  title="Exercises | 0xSac"
  description="Preview 0xSac scenario guides, topologies, and runbooks mapped to defender learning objectives."
  canonical="/exercises/"
>
  <section>
    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-emerald-300">Scenario catalog</p>
    <h1 class="mt-2 text-4xl font-semibold text-white">Exercises</h1>
    <p class="mt-4 max-w-3xl text-slate-300">Portable scenario guides, topologies, and runbooks built for open lab environments.</p>
    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      {exercises.map((exercise) => (
        <article class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
          <p class="text-xs uppercase tracking-[0.3em] text-emerald-300">{exercise.data.difficulty} · {exercise.data.duration}</p>
          <h2 class="mt-3 text-2xl font-semibold text-white">
            <a href={`/exercises/${exercise.id}/`} class="hover:text-emerald-300">{exercise.data.title}</a>
          </h2>
          <p class="mt-3 text-sm text-slate-400">{exercise.data.description}</p>
          <p class="mt-4 text-xs text-slate-500">{exercise.data.attackIds.join(' · ')}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
