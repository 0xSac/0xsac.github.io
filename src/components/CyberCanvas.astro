<canvas id="cyber-canvas" class="fixed inset-0 pointer-events-none z-0 w-full h-full opacity-40"></canvas>

<script>
  function initCyberCanvas() {
    const canvas = document.getElementById('cyber-canvas') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.initialized === 'true') return;
    canvas.dataset.initialized = 'true';

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    const mouse = { x: -1000, y: -1000 };

    type Particle = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
    };

    const resize = () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    };

    resize();
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', (event) => {
      mouse.x = event.clientX;
      mouse.y = event.clientY;
    });
    window.addEventListener('mouseout', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    const particles: Particle[] = Array.from({ length: 70 }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.8,
      vy: (Math.random() - 0.5) * 0.8,
      radius: Math.random() * 1.6 + 1
    }));

    const maxSpeed = 1.4;
    const repulseRadius = 130;
    const connectionDistance = 120;

    const updateParticle = (p: Particle) => {
      const dx = p.x - mouse.x;
      const dy = p.y - mouse.y;
      const dist = Math.hypot(dx, dy);

      if (dist < repulseRadius && dist > 0.001) {
        const strength = ((repulseRadius - dist) / repulseRadius) * 0.08;
        p.vx += (dx / dist) * strength;
        p.vy += (dy / dist) * strength;
      }

      p.vx *= 0.992;
      p.vy *= 0.992;

      const speed = Math.hypot(p.vx, p.vy);
      if (speed > maxSpeed) {
        p.vx = (p.vx / speed) * maxSpeed;
        p.vy = (p.vy / speed) * maxSpeed;
      }

      p.x += p.vx;
      p.y += p.vy;

      if (p.x <= p.radius || p.x >= width - p.radius) {
        p.vx *= -1;
        p.x = Math.min(width - p.radius, Math.max(p.radius, p.x));
      }
      if (p.y <= p.radius || p.y >= height - p.radius) {
        p.vy *= -1;
        p.y = Math.min(height - p.radius, Math.max(p.radius, p.y));
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = 'rgba(56, 189, 248, 0.85)';

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        updateParticle(p);

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const d = Math.hypot(p.x - p2.x, p.y - p2.y);
          if (d < connectionDistance) {
            const alpha = (1 - d / connectionDistance) * 0.45;
            ctx.strokeStyle = `rgba(56, 189, 248, ${alpha})`;
            ctx.lineWidth = 0.7;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    };

    draw();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCyberCanvas);
  }
  initCyberCanvas();
</script>